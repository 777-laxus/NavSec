{
  "manifest_version": 3,
  "name": "NavSec",
  "version": "0.1.0",
  "description": "Analisa as tecnologias web e bibliotecas JavaScript da pagina atual em busca de vulnerabilidades conhecidas.",
  "action": {
    "default_title": "NavSec",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting", "tabs"],
  "host_permissions": [
    "https://api.osv.dev/*",
    "https://www.virustotal.com/*",
    "https://api.abuseipdb.com/*",
    "https://dns.google/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "scripts/vulnerabilidades/sink-interceptor.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "scripts/vulnerabilidades/sink-relay.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
